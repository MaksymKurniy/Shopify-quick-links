{
  "name": "shopify-quick-links",
  "displayName": "Shopify Quick Links",
  "description": "A Visual Studio Code extension that provides quick access to Shopify documentation and resources directly from the editor.",
  "version": "0.0.1",
  "publisher": "MaksymKurniy",
  "repository": "https://github.com/MaksymKurniy/shopify-quick-links",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "tags": [
    "shopify", "links", "documentation", "productivity"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:quickLinksSidebar"
  ],
  "contributes": {
    "configuration": {
      "title": "Shopify Quick Links",
      "properties": {
        "shopifyQuickLinks.storeHandle": {
          "type": "string",
          "default": "",
          "description": "Your Shopify store handle (e.g., 'my-store' for my-store.myshopify.com). If empty, workspace name will be used.",
          "examples": ["my-awesome-store", "demo-shop"]
        },
        "shopifyQuickLinks.documentationLinks": {
          "type": "array",
          "default": [],
          "description": "Custom documentation links. Leave empty to use defaults. Each item should have: label, url, icon (optional), tooltip (optional).",
          "items": {
            "type": "object",
            "properties": {
              "label": {"type": "string"},
              "url": {"type": "string"},
              "icon": {"type": "string"},
              "tooltip": {"type": "string"}
            },
            "required": ["label", "url"]
          }
        },
        "shopifyQuickLinks.customCategories": {
          "type": "array",
          "default": [],
          "description": "Custom link categories. Each category should have: name, icon, links array.",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "icon": {"type": "string"},
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {"type": "string"},
                    "url": {"type": "string"},
                    "icon": {"type": "string"},
                    "tooltip": {"type": "string"}
                  },
                  "required": ["label", "url"]
                }
              }
            },
            "required": ["name", "links"]
          }
        }
      }
    },
    "commands": [
      {
        "command": "quickLinks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "quickLinks.shopifyDev",
        "title": "Shopify: Start Theme Dev"
      },
      {
        "command": "quickLinks.shopifyPull",
        "title": "Shopify: Pull Theme JSON"
      },
      {
        "command": "quickLinks.setStoreHandle",
        "title": "Shopify: Set Store Handle"
      },
      {
        "command": "quickLinks.openGitRepo",
        "title": "Open Git Repository"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shopifyQuickLinks",
          "title": "Shopify Quick Links",
          "icon": "media/shopify_glyph_black.svg"
        }
      ]
    },
    "views": {
      "shopifyQuickLinks": [
        {
          "id": "quickLinksSidebar",
          "name": "Shopify Quick Links",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "quickLinks.refresh",
          "when": "view == quickLinksSidebar",
          "group": "navigation",
          "icon": "$(refresh)"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "test": "jest"
  },
  "devDependencies": {
    "@types/vscode": "^1.54.0",
    "jest": "^30.0.4"
  },
  "dependencies": {}
}
