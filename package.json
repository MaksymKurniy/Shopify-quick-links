{
  "name": "shopify-quick-links",
  "displayName": "Shopify Quick Links",
  "description": "A Visual Studio Code extension that provides quick access to Shopify documentation and resources directly from the editor.",
  "version": "0.0.1",
  "publisher": "MaksymKurniy",
  "repository": "https://github.com/MaksymKurniy/shopify-quick-links",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "tags": [
    "shopify", "links", "documentation", "productivity"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:quickLinksSidebar"
  ],
  "contributes": {
    "configuration": {
      "title": "Shopify Quick Links",
      "properties": {
        "shopifyQuickLinks.storeHandle": {
          "type": "string",
          "default": "",
          "description": "Your Shopify store handle (e.g., 'my-store' for my-store.myshopify.com). If empty, workspace name will be used.",
          "examples": ["my-awesome-store", "demo-shop"]
        }
      }
    },
    "commands": [
      {
        "command": "quickLinks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shopifyQuickLinks",
          "title": "Shopify Quick Links",
          "icon": "media/shopify_glyph_black.svg"
        }
      ]
    },
    "views": {
      "shopifyQuickLinks": [
        {
          "id": "quickLinksSidebar",
          "name": "Shopify Quick Links",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "quickLinks.refresh",
          "when": "view == quickLinksSidebar",
          "group": "navigation",
          "icon": "$(refresh)"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "test": "jest"
  },
  "devDependencies": {
    "@types/vscode": "^1.54.0",
    "jest": "^30.0.4"
  },
  "dependencies": {}
}
